# Copy to .env.local for development. Never commit real values.
DATABASE_URL=postgres://learning_os_app:app@127.0.0.1:5433/learning_os
DATABASE_MIGRATOR_URL=postgres://learning_os_migrator:migrator@127.0.0.1:5433/learning_os
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_URL=http://localhost:3000
# Google OAuth (MVP sign-in). Leave unset to run with the dev login only.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Development-only sign-in form. Refused in production.
AUTH_DEV_LOGIN=true
# Access-code sign-in for evaluators (allowed in production). Both must be set;
# the code needs 24+ characters, the emails are comma separated.
# AUTH_ACCESS_CODE=
# AUTH_ACCESS_EMAILS=
# AI provider: "null" (default, no AI) or "openai"
AI_PROVIDER=null
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Better model for the "Alto" conversation quality (conversation, openings, open grading, report comments).
OPENAI_MODEL_HIGH=gpt-5.4-mini
# Live voice lessons (speech to speech). Standard / high conversation quality, voice, and the transcript the system grades.
OPENAI_REALTIME_MODEL=gpt-realtime-mini
OPENAI_REALTIME_MODEL_HIGH=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
LOG_LEVEL=info
